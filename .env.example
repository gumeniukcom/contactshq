# Copy to .env before running `docker compose up -d`.

# Required. Generate with: openssl rand -hex 32
CHQ_AUTH_JWT_SECRET=

# Public sign-up. Leave false unless you want anyone who can reach the port to create an
# account: the first account is always allowed regardless, so you can still bootstrap the
# instance, and an admin can add users from the UI at any time.
# CHQ_AUTH_ALLOW_REGISTRATION=false

# Max decompressed size a restore will read, in bytes (default 134217728 = 128 MiB).
# CHQ_BACKUP_MAX_RESTORE_BYTES=134217728
